# Supabase project (South America / Sao Paulo region)
# Both of these are public by construction -- they ship inside the app.
# What protects the data is RLS, not the secrecy of the key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service_role key here, or anywhere else in the app.
